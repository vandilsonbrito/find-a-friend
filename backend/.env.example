NODE_ENV=dev
PORT=3333
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=troque-por-um-segredo

# Database (bate com o docker-compose.yml)
DATABASE_URL="postgresql://findafriend:findafriend@localhost:5433/findafriend?schema=public"

# Storage das fotos dos pets: "cloudinary" (padrão) ou "fake" (não sobe nada,
# devolve uma URL fixa — útil no dev para não gastar a cota). Os testes E2E
# sempre usam "fake".
STORAGE_DRIVER=cloudinary

# Cloudinary (upload de fotos dos pets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
