generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id            String   @id @default(uuid())
  name          String
  description   String
  email         String   @unique
  password_hash String
  whatsapp      String
  address       String
  city          String
  state         String
  cep           String
  pets           Pet[]
  refresh_tokens RefreshToken[]
  created_at     DateTime       @default(now())
}

model RefreshToken {
  id          String    @id @default(uuid())
  org_id      String
  expires_at  DateTime
  replaced_at DateTime?
  revoked_at  DateTime?
  created_at  DateTime  @default(now())

  org Org @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
}

model Pet {
  id                 String      @id @default(uuid())
  org_id             String
  name               String
  description        String?
  age                Age
  size               Size
  energy_level       EnergyLevel
  independence_level IndependenceLevel
  environment        Environment
  breed              String
  sex                Sex
  type               Type
  city               String
  state              String
  is_adopted         Boolean     @default(false)
  created_at         DateTime    @default(now())

  org               Org         @relation(fields: [org_id], references: [id])
  photos            PetPhoto[]
}

model PetPhoto {
  id     String  @id @default(uuid())
  pet_id String
  url    String

  pet    Pet     @relation(fields: [pet_id], references: [id], onDelete: Cascade)
}

enum Age {
  puppy
  adult
  senior
}

enum Size {
  small
  medium
  large
}

enum EnergyLevel {
  low
  medium
  high
}

enum IndependenceLevel {
  low
  medium
  high
}

enum Environment {
  small
  medium
  large
}
enum Sex {
  male
  female
}
enum Type {
  dog
  cat
}